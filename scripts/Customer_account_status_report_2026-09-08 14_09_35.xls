<script>
	$(document).ready(function () {
		var customerlistselect = $("#customerlistselect").val();
		var customerlistselect_server = '';
		if(customerlistselect_server == 'stbwise'){
		   $("#customerselectlistshowhide").hide();
		}else if(customerlistselect == 'stbwise'){
			$("#customerselectlistshowhide").hide();
		}
		$("#customerlistselect").click(function(){
			var customerlistselect = $("#customerlistselect").val();
			if(customerlistselect =='stbwise'){
				$("#customerselectlistshowhide").hide();
			}else if(customerlistselect =='packagewise'){
			    $("#customerselectlistshowhide").show();
			}
		});
});
</script>		