rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function admin() { return signedIn() && role() == 'admin'; }
    function staff() { return signedIn() && role() == 'staff'; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owns(uid) || admin();
      // Registration never grants staff/admin access. Provision those with a trusted Admin SDK.
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'photoURL', 'phone', 'address', 'updatedAt'])
        && request.resource.data.role == 'subscriber';
      // Owners may only fill in phone/address (e.g. profile completion); role/name/email/photoURL are immutable from the client.
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'address', 'updatedAt']);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write: if owns(uid);
      }
    }
    match /subscribers/{uid} {
      allow read: if admin() || owns(uid)
        || (staff() && resource.data.collectorId == request.auth.uid);
      allow write: if admin();
    }
    match /customers/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /customer_accounts/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /services/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /service_providers/{id} {
      allow read: if signedIn();
      allow write: if admin();

      match /packages/{packageId} {
        allow read: if signedIn();
        allow write: if admin();
      }
    }
    match /payments/{id} {
      allow read: if admin()
        || (staff() && resource.data.collectorId == request.auth.uid)
        || (signedIn() && resource.data.subscriberId == request.auth.uid);
      // Payments require a trusted backend; clients must not rewrite financial records.
      allow write: if false;
    }
    match /packages/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /tickets/{id} {
      allow read: if admin()
        || (staff() && resource.data.assignedTo == request.auth.uid)
        || (signedIn() && resource.data.subscriberId == request.auth.uid);
      allow create: if admin() || signedIn();
      // Staff may only progress a ticket assigned to them; reassignment stays with admins.
      allow update: if admin()
        || (staff() && resource.data.assignedTo == request.auth.uid
            && request.resource.data.assignedTo == resource.data.assignedTo);
      allow delete: if admin();
    }
  }
}
