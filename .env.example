# Copy to .env (development default), .env.development, and .env.production with
# Expo CLI loads .env.$NODE_ENV automatically.
# falling back to .env for anything not overridden. See package.json's *:preview/*:production
# scripts for how NODE_ENV is set per environment.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
